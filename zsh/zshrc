setopt prompt_subst   # required by Powerlevel10k

repush() {
    local source="$1"
    local target_registry="us-east1-docker.pkg.dev/loblaw-container-registry/ld-golden-images-staging"
    local image_tag=$(echo "$source" | awk -F'/' '{print $NF}')  # just elixir:1.14-otp-25-alpine

    docker pull --platform linux/amd64 "$source" &&
    docker tag "$source" "${target_registry}/${image_tag}" &&
    docker push "${target_registry}/${image_tag}"
}

# List images in GCP Artifact Registry
list_images() {
  local repo="ld-golden-images"
  local filter=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)   repo="$2";   shift 2 ;;
      --filter) filter="$2"; shift 2 ;;
      *)        filter="$1";  shift   # bare arg treated as filter
    esac
  done

  local base="us-east1-docker.pkg.dev/loblaw-container-registry/${repo}"
  local cmd=(gcloud artifacts docker images list "${base}" --project=loblaw-container-registry --include-tags --limit=unlimited --format="table(package, tags, format)")

  [[ -n "$filter" ]] && cmd+=(--filter="package:${filter}")

  "${cmd[@]}"
}

