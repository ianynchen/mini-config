# Homebrew
eval "$(/opt/homebrew/bin/brew shellenv)"

# Homebrew Python: provides unversioned python/pip commands
export PATH="$(brew --prefix python)/libexec/bin:$PATH"


# -----------------------------
# 1. Powerlevel10k instant prompt (top of file)
# -----------------------------
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# -----------------------------
# 2. Zinit plugin manager
# -----------------------------
ZINIT_DIR="$HOME/.local/share/zinit/zinit.git"

if [[ ! -f "$ZINIT_DIR/zinit.zsh" ]]; then
    echo "Installing Zinit..."
    mkdir -p "$HOME/.local/share/zinit" && chmod g-rwX "$HOME/.local/share/zinit"
    git clone https://github.com/zdharma-continuum/zinit "$ZINIT_DIR" \
        && echo "Zinit installed" || echo "Zinit installation failed"
fi

if [[ -f "$ZINIT_DIR/zinit.zsh" ]]; then
    source "$ZINIT_DIR/zinit.zsh"
    autoload -Uz _zinit
    (( ${+_comps} )) && _comps[zinit]=_zinit

    # -----------------------------
    # 3. Load Powerlevel10k first!
    # -----------------------------
    zinit light romkatv/powerlevel10k

    # -----------------------------
    # 4. Other Zinit plugins
    # -----------------------------
    zinit load zdharma-continuum/history-search-multi-word
    zinit light zsh-users/zsh-autosuggestions
    zinit light zdharma-continuum/fast-syntax-highlighting

    # Optional snippet
    zinit snippet https://gist.githubusercontent.com/hightemp/5071909/raw/
fi
# The gist snippet above aliases gh='git push', shadowing the GitHub CLI — undo that
unalias gh 2>/dev/null

# -----------------------------
# 5. Source Powerlevel10k config
# -----------------------------
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# -----------------------------
